# PotatoSMP Website Configuration
# Copy this file to .env and fill in your values

# Server Connection
VITE_SERVER_ADDRESS=play.potatosmp.net
VITE_SERVER_EDITION=java  # java | bedrock

# Stats Data Source
# Options: demo | plan | custom
# demo = built-in demo data (default)
# plan = Plan Player Analytics plugin (requires VITE_STATS_API_URL)
# custom = Custom API endpoint (requires VITE_STATS_API_URL)
VITE_STATS_MODE=demo

# Plan Player Analytics / Custom API
# VITE_STATS_API_URL=http://localhost:8080

# Map Configuration
# VITE_MAP_URL=https://map.potatosmp.net
# VITE_MAP_EMBEDDABLE=true
# VITE_MAP_NAME=BlueMap

# Store Configuration
# VITE_STORE_URL=https://store.potatosmp.net

# Discord
# VITE_DISCORD_URL=https://discord.gg/potatosmp

# Analytics (optional)
# VITE_GA_ID=G-XXXXXXXXXX